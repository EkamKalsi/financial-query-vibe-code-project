# Copy this file to .env and fill in any values you want to override.
# No API keys or Reddit credentials are required — the scraper uses
# Reddit's public .json endpoint.

# ---------------------------------------------------------------------------
# HTTP identity (recommended: set this to something descriptive)
# Reddit may block requests that use a generic or missing User-Agent.
# ---------------------------------------------------------------------------
REDDIT_USER_AGENT=FinancialQueryBot/0.1 (research project)

# ---------------------------------------------------------------------------
# Scraper tuning (all optional — defaults shown)
# ---------------------------------------------------------------------------
MAX_POSTS_PER_SUBREDDIT=500
MAX_COMMENTS_PER_POST=50
MIN_POST_SCORE=10
DEFAULT_SORT=hot
DEFAULT_TIME_FILTER=week

# Seconds between requests (stay polite — keep at >= 1.0)
REQUEST_DELAY_SECONDS=1.1

# Back-off base when a 429 is received
RATE_LIMIT_BACKOFF_SECONDS=5.0
MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Embedding agent tuning (all optional — defaults shown)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_COMMENTS_TO_EMBED=5
EMBEDDING_BATCH_SIZE=64

# ---------------------------------------------------------------------------
# Query agent
# ---------------------------------------------------------------------------
# Required — get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional tuning
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
TOP_K_RESULTS=5
QUERY_MAX_TOKENS=1024
